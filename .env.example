# =============================================================================
# FinApp — Environment Configuration Example
# =============================================================================

# Server port (inside container and mapped to host)
PORT=6253

# PostgreSQL credentials (used by the included db service)
# POSTGRES_PASSWORD is REQUIRED — docker compose refuses to start without it.
# Generate one with: openssl rand -hex 16   (hex keeps it safe inside DATABASE_URL)
POSTGRES_USER=finapp
POSTGRES_PASSWORD=
POSTGRES_DB=finapp

# Full database URL. Only needed for an EXTERNAL PostgreSQL instance;
# the included docker-compose.yml builds it automatically from POSTGRES_* above.
# DATABASE_URL=postgres://user:password@host:5432/finapp

# PostgreSQL SSL/TLS settings
# Set DATABASE_SSL=true for external managed Postgres (e.g. DigitalOcean, AWS RDS, Supabase)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# JWT signing secret — REQUIRED, at least 32 characters. Never reuse a published value:
# anyone who knows it can forge admin tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Timezone for Node.js and PostgreSQL timestamps
# Examples: UTC, Europe/Moscow, Europe/Berlin, America/New_York
TZ=UTC

# Default language for new users (ru, en)
DEFAULT_LANG=en

# Encryption key for sensitive user settings (VAPID private key, Shoutrrr URL, CoinGecko API key).
# REQUIRED — the server refuses to start without it. Must be exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# Back it up: losing or changing it makes already-stored encrypted settings unreadable.
ENCRYPTION_KEY=

# =============================================================================
# Optional
# =============================================================================
# Allowed CORS origins (comma-separated). Leave empty for same-origin.
ALLOWED_ORIGINS=

# Trusted reverse proxies (comma-separated IPs/CIDRs). Set when running behind Traefik/Nginx/Caddy.
TRUSTED_PROXIES=

# Container runtime user/group IDs (default 1000:1000).
# Uses the existing `node` user from the base image by default.
# Set these to match the host user that owns mounted files/backups.
PUID=1000
PGID=1000

# Reject Shoutrrr/webhook targets on private/loopback addresses (SSRF protection), on by default.
# Set to false only if your users must notify services on the local network (e.g. a local Gotify).
SHOUTRRR_BLOCK_PRIVATE_TARGETS=true
# Comma-separated hostnames exempt from that check, e.g. a self-hosted Gotify whose name
# resolves to a LAN address: SHOUTRRR_ALLOWED_HOSTS=gotify.example.com
SHOUTRRR_ALLOWED_HOSTS=

# Server-wide CoinGecko API key, used when a user has not saved their own in Settings.
COINGECKO_API_KEY=

# Log level: fatal, error, warn, info, debug, trace (default: info in the container)
LOG_LEVEL=info

# Timeout in milliseconds for sending one Web Push notification
PUSH_SEND_TIMEOUT=10000
